# OpenMarketing Hub Desktop - Environment Configuration
# Copy this file to .env and fill in your values

# Backend API URL (for development)
VITE_API_URL=http://localhost:3000

# For production, use the deployed backend URL
# VITE_API_URL=https://api.openmarketing-hub.com

# Tauri
TAURI_DEVTOOLS_ENABLED=false

# Android Build (for APK)
# Set these environment variables before running tauri build
# export JAVA_HOME=/path/to/jdk-17
# export ANDROID_HOME=$HOME/Android/Sdk
# export ANDROID_SDK_ROOT=$ANDROID_HOME
# export ANDROID_NDK_HOME=$ANDROID_HOME/ndk/25.2.9519653

# Signing (for release builds)
# Tauri signing is configured in tauri.conf.json
# Under bundle.android.key section
