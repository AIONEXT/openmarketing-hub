# OpenMarketing Hub - Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://openmarketing:change-me@localhost:5432/openmarketing_hub

# Redis
REDIS_URL=redis://localhost:6379

# Security - Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Meta (Facebook)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token

# Google Tag Manager
GTM_CONTAINER_ID=GTM-XXXXXXX

# CORS (comma-separated origins in production)
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# HSTS (HTTPS)
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUB_DOMAINS=true
HSTS_PRELOAD=true

# SSL (if terminating TLS at the app)
ENABLE_SSL=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Sync & Retry
SYNC_INTERVAL_MS=300000
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# Logging
LOG_LEVEL=info

# Uploads
UPLOAD_PATH=./uploads
